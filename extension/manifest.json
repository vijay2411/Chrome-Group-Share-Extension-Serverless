{
  "manifest_version": 3,
  "name": "GroupShare",
  "version": "1.0.0",
  "description": "Share Chrome Tab Groups as a single link. Recipients open all tabs instantly.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
